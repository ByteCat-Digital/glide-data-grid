{
    "name": "@bytecat/glide-data-grid-source",
    "version": "6.1.1",
    "description": "Useful data source hooks for Glide Data Grid",
    "sideEffects": false,
    "type": "module",
    "browser": "dist/esm/index.js",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/dts/index.d.ts",
    "exports": {
        "types": "./dist/dts/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "./build.sh",
        "lint": "eslint src --ext .ts,.tsx",
        "test": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ByteCat-Digital/glide-data-grid.git",
        "directory": "packages/source"
    },
    "homepage": "https://github.com/ByteCat-Digital/glide-data-grid/tree/main/packages/source",
    "author": "Bytecat; forked from Glide Data Grid",
    "license": "MIT",
    "keywords": [
        "react",
        "datagrid",
        "data-grid",
        "editor",
        "reactjs",
        "scrolling",
        "data",
        "table",
        "cell",
        "canvas"
    ],
    "dependencies": {
        "@bytecat/glide-data-grid": "6.1.1"
    },
    "peerDependencies": {
        "lodash": "^4.17.19",
        "react": "^16.12.0 || 17.x || 18.x || 19.x",
        "react-dom": "^16.12.0 || 17.x || 18.x || 19.x"
    },
    "devDependencies": {
        "@babel/cli": "^8.0.4",
        "eslint": "^9.39.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "react-resize-detector": "^12.3.0",
        "tsc-esm-fix": "^3.1.2"
    }
